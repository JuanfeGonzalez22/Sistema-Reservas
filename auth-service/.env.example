# ==============================================
#  auth-service - plantilla de variables de entorno
#  Copiar a .env y rellenar con valores reales:
#     cp .env.example .env
# ==============================================

# --- JWT ---
# Generar con: openssl rand -base64 48
JWT_SECRET=CAMBIAR_por_una_clave_aleatoria_de_al_menos_32_bytes
JWT_EXPIRATION_MS=3600000

# --- Base de datos (debe coincidir con compose.yaml) ---
DB_URL=jdbc:postgresql://localhost:5432/mydatabase
DB_USERNAME=myuser
DB_PASSWORD=CAMBIAR

# --- Usuario administrador inicial (seeder) ---
ADMIN_EMAIL=admin@sistema-reservas.com
ADMIN_PASSWORD=CAMBIAR
