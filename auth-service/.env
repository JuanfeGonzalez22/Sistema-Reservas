# ==============================================
#  auth-service - variables de entorno (LOCAL)
#  NO commitear este archivo. Ver .env.example
# ==============================================

# --- JWT ---
# Clave para firmar los tokens (HS256 -> minimo 32 bytes).
# Generar una nueva con: openssl rand -base64 48
JWT_SECRET=qD9d6gK7JpFos5Gm95KYUTMk02PIkmtCkVlkRa0Bxd4ybPfVgvbzkUjEJ0k8hlF+
# Vigencia del token en milisegundos (3600000 = 1 hora)
JWT_EXPIRATION_MS=3600000

# --- Base de datos (debe coincidir con compose.yaml) ---
DB_URL=jdbc:postgresql://localhost:5432/mydatabase
DB_USERNAME=myuser
DB_PASSWORD=secret

# --- Usuario administrador inicial (seeder) ---
ADMIN_EMAIL=admin@sistema-reservas.com
ADMIN_PASSWORD=Admin1234!
